{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/instructions/*.md"],

  "default_agent": "orchestrator",
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    }
  },

  "permissions": [
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    }
  ],

  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:sudo *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:rm -r *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:rm -R *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git clean *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:Remove-Item *Recurse*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:rd /s *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:rmdir /s *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:del /s *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:erase /s *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:curl *|*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:wget *|*",
      "effect": "deny"
    }
  ],

  "compaction": {
    "auto": false
  }
}
