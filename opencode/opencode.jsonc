{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/instructions/*.md"],

  "worktree": { "directory": "../worktrees" },
  "plugins": [
    {
      "package": "./plugins/orchestra",
      "options": {
        "models": {
          "scout":    { "providerID": "anthropic", "id": "claude-haiku-5-5" },
          "builder":  { "providerID": "anthropic", "id": "claude-sonnet-5-5" },
          "refactor": { "providerID": "anthropic", "id": "claude-fable-5-1" },
          "advisor":  { "providerID": "anthropic", "id": "claude-opus-5-5" }
        },
        "worktreeInclude": [".env", ".env.local"],
        "jev": { "enabled": true, "maxErrorChars": 2000 }
      }
    }
  ],

  "default_agent": "orchestrator",
  "agents": {
    "build": {
      "disabled": true,
    },
    "plan": {
      "disabled": true,
    },
  },

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "~/AppData/Local/Temp/*",
      "effect": "allow",
    },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },

    { "action": "edit", "resource": "*.git/hooks/*", "effect": "ask" },
    { "action": "edit", "resource": "*.git/config", "effect": "ask" },
    { "action": "edit", "resource": "*.opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "*opencode.json", "effect": "ask" },
    { "action": "edit", "resource": "*opencode.jsonc", "effect": "ask" },

    { "action": "shell", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git show *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "git --no-pager diff *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "rtk git --no-pager diff *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git --no-pager log *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "rtk git --no-pager log *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git --no-pager show *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "rtk git --no-pager show *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git shortlog *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "rtk git merge-base *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "git show-ref *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git show-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git reflog", "effect": "allow" },
    { "action": "shell", "resource": "rtk git reflog", "effect": "allow" },
    { "action": "shell", "resource": "git reflog show *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "rtk git reflog show *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git stash list *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "rtk git stash list *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git stash show *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "rtk git stash show *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git worktree list *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "rtk git worktree list *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git config --get*", "effect": "allow" },
    {
      "action": "shell",
      "resource": "rtk git config --get*",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git config --list*", "effect": "allow" },
    {
      "action": "shell",
      "resource": "rtk git config --list*",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git remote", "effect": "allow" },
    { "action": "shell", "resource": "rtk git remote", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "rtk git remote -v", "effect": "allow" },
    {
      "action": "shell",
      "resource": "git remote get-url *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "rtk git remote get-url *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git tag", "effect": "allow" },
    { "action": "shell", "resource": "rtk git tag", "effect": "allow" },
    { "action": "shell", "resource": "git tag -l *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git tag -l *", "effect": "allow" },
    { "action": "shell", "resource": "git branch", "effect": "allow" },
    { "action": "shell", "resource": "rtk git branch", "effect": "allow" },
    {
      "action": "shell",
      "resource": "git branch --show-current",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "rtk git branch --show-current",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git branch -a", "effect": "allow" },
    { "action": "shell", "resource": "rtk git branch -a", "effect": "allow" },
    { "action": "shell", "resource": "git branch -r", "effect": "allow" },
    { "action": "shell", "resource": "rtk git branch -r", "effect": "allow" },
    { "action": "shell", "resource": "git branch -v", "effect": "allow" },
    { "action": "shell", "resource": "rtk git branch -v", "effect": "allow" },
    { "action": "shell", "resource": "git branch -vv", "effect": "allow" },
    { "action": "shell", "resource": "rtk git branch -vv", "effect": "allow" },
    { "action": "shell", "resource": "git --version", "effect": "allow" },

    { "action": "shell", "resource": "codegraph explore *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rtk rg *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rtk grep *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rtk ls *", "effect": "allow" },
    { "action": "shell", "resource": "dir *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "rtk tree *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "rtk read *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "rtk wc *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "where.exe *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Command *", "effect": "allow" },
    { "action": "shell", "resource": "Get-ChildItem *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Content *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Item *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Location", "effect": "allow" },
    { "action": "shell", "resource": "Select-String *", "effect": "allow" },
    { "action": "shell", "resource": "Test-Path *", "effect": "allow" },
    { "action": "shell", "resource": "Resolve-Path *", "effect": "allow" },
    { "action": "shell", "resource": "Split-Path *", "effect": "allow" },
    { "action": "shell", "resource": "Join-Path *", "effect": "allow" },
    { "action": "shell", "resource": "Measure-Object *", "effect": "allow" },
    { "action": "shell", "resource": "Select-Object *", "effect": "allow" },
    { "action": "shell", "resource": "Sort-Object *", "effect": "allow" },
    { "action": "shell", "resource": "Where-Object *", "effect": "allow" },
    { "action": "shell", "resource": "Format-Table *", "effect": "allow" },
    { "action": "shell", "resource": "Format-List *", "effect": "allow" },
    { "action": "shell", "resource": "Out-String *", "effect": "allow" },

    { "action": "shell", "resource": "*rg *--pre*", "effect": "ask" },
    { "action": "shell", "resource": "*git grep *-O*", "effect": "ask" },
    {
      "action": "shell",
      "resource": "*git grep *--open-files-in-pager*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "*git fetch *--upload-pack*",
      "effect": "ask",
    },
    { "action": "shell", "resource": "*git *--output*", "effect": "ask" },
  ],

  "policies": [
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rtk sudo *", "effect": "deny" },
    {
      "action": "tool.use",
      "resource": "shell:*git push*--force*",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:*git push* -f",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:*git push* -f *",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:*git push* +*",
      "effect": "deny",
    },

    { "action": "tool.use", "resource": "read:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.p12", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pfx", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.ssh/*", "effect": "deny" },
  ],

  "compaction": {
    "auto": false,
  },
}
